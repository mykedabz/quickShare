const base = Xrm.Utility.getGlobalContext().getClientUrl() + "/api/data/v9.2/";
const H2 = { Accept: "application/json", "OData-Version": "4.0", "OData-MaxVersion": "4.0", "Content-Type": "application/json" };
const team = (await (await fetch(base + "teams?$select=teamid,name&$filter=name eq 'AD-PP-SS-94180-EDM-PRD-BasicUser'", { headers: H2 })).json()).value[0];
async function teamCount() {
  let n = 0, url = `${base}teams(${team.teamid})/teammembership_association?$select=systemuserid`;
  while (url) { const j = await (await fetch(url, { headers: { ...H2, Prefer: "odata.maxpagesize=5000" } })).json(); n += j.value.length; url = j["@odata.nextLink"]; }
  return n;
}
console.log("In team before:", await teamCount(), "· sync started", new Date().toLocaleTimeString());
const t0 = Date.now();
const r = await fetch(`${base}teams(${team.teamid})/Microsoft.Dynamics.CRM.SyncGroupMembersToTeam`, { method: "POST", headers: H2, body: "{}" });
console.log("Sync:", r.status, `${Math.round((Date.now() - t0) / 1000)}s`, r.ok ? "" : (await r.text()).slice(0, 800));
console.log("In team after:", await teamCount());


